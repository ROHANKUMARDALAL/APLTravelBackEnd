# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB (ONE source of truth for local + Render)
# Paste the same Atlas URI used in Render → Environment → MONGODB_URI
# so local backend shares users, travellers, and bookings with live.
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/apl_travel
MONGODB_URI=mongodb://127.0.0.1:27017/apl_travel

# CORS (comma-separated origins; empty = allow all in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Phase 8 — public tenant resolution
# Production base domain for subdomain DSA sites: {subdomain}.{PUBLIC_TENANT_BASE_DOMAIN}
PUBLIC_TENANT_BASE_DOMAIN=
# Development-only host → DSA code map (IGNORED when NODE_ENV=production)
# Example: localhost:3001=APL-DSA-0001,127.0.0.1:3001=APL-DSA-0001
# Dev-only host → DSA code map for public + transactional tenant resolution.
# Example: localhost:3001=APL-DSA-0034,127.0.0.1:3001=APL-DSA-0034
PUBLIC_DEV_HOST_MAP=

# Rate limiting
THROTTLE_WINDOW_MS=60000
THROTTLE_LIMIT=120

# APL commercial layer (do not hard-code business markups in adapters)
# Percentage markup applied on top of supplier price. Keep 0 until pricing rules are configured.
DEFAULT_MARKUP_PERCENT=0

# Mock supplier behavior
# Comma-separated supplier codes that should simulate failure during search (e.g. KAFILA)
MOCK_SUPPLIER_FAILURES=

# Phase 10 — observability retention / payload caps (operational logs only)
# ServiceLog TTL days (default 90). Set 0/negative to disable TTL index creation.
SERVICE_LOG_RETENTION_DAYS=90
# SupplierRawPayload TTL days (default 30). Audit/booking records are NOT covered.
SUPPLIER_RAW_PAYLOAD_RETENTION_DAYS=30
SERVICE_LOG_INLINE_MAX_CHARS=12000
SUPPLIER_RAW_PAYLOAD_MAX_CHARS=80000

# Phase 11A — supplier HTTP timeout (ms)
SUPPLIER_HTTP_TIMEOUT_MS=15000

# Phase 11 — TEST/SANDBOX credentials (NEVER commit real values)
# Preferred pattern (credentialRef = SUPPLIER_{CODE}):
#   SUPPLIER_TBO_TEST_BASE_URL=
#   SUPPLIER_TBO_TEST_USERNAME=
#   SUPPLIER_TBO_TEST_PASSWORD=
#   SUPPLIER_TBO_TEST_API_KEY=
# Legacy placeholders (still resolved as fallback):
TBO_API_URL=
TBO_USERNAME=
TBO_PASSWORD=

TRIPJACK_API_URL=
TRIPJACK_USERNAME=
TRIPJACK_PASSWORD=

KAFILA_API_URL=
KAFILA_USERNAME=
KAFILA_PASSWORD=

# Phase 4 — APL Super Admin bootstrap (CLI only; never commit real values)
# APL_BOOTSTRAP_ADMIN_EMAIL=you@company.com
# APL_BOOTSTRAP_ADMIN_PASSWORD=
# APL_BOOTSTRAP_ADMIN_NAME=APL Super Admin
# APL_BOOTSTRAP_ADMIN_PHONE=

# Phase 4 — optional DSAAdmin bootstrap for local testing (CLI only)
# DSA_BOOTSTRAP_ADMIN_EMAIL=owner@dsa.example
# DSA_BOOTSTRAP_ADMIN_PASSWORD=
# DSA_BOOTSTRAP_CREATE_DSA=1
# DSA_BOOTSTRAP_DSA_ID=
# DSA_BOOTSTRAP_ROLE=DSA_OWNER
