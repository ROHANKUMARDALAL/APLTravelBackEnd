# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB (source of truth)
MONGODB_URI=mongodb://127.0.0.1:27017/apl_travel

# CORS (comma-separated origins; empty = allow all in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
THROTTLE_WINDOW_MS=60000
THROTTLE_LIMIT=120

# APL commercial layer (do not hard-code business markups in adapters)
# Percentage markup applied on top of supplier price. Keep 0 until pricing rules are configured.
DEFAULT_MARKUP_PERCENT=0

# Mock supplier behavior
# Comma-separated supplier codes that should simulate failure during search (e.g. KAFILA)
MOCK_SUPPLIER_FAILURES=

# Future real supplier credentials (placeholders — do not invent undocumented fields)
TBO_API_URL=
TBO_USERNAME=
TBO_PASSWORD=

TRIPJACK_API_URL=
TRIPJACK_USERNAME=
TRIPJACK_PASSWORD=

KAFILA_API_URL=
KAFILA_USERNAME=
KAFILA_PASSWORD=
